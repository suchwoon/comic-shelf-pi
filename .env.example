# Required for all access. Run `node scripts/setup.mjs` to generate a password.
# Do not commit .env.local.
BOOKS_PASSWORD=

# Public HTTPS address when using a domain. Leave empty for local use only.
PUBLIC_ORIGIN=

# Persistent storage, outside public/. Relative paths resolve from project root.
DATA_DIR=./data

# Maximum size of one uploaded PDF, in MiB. Large files use smaller requests.
MAX_UPLOAD_MB=256
