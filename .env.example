# Initial administrator password, used only when the account database is empty.
# After first sign-in, change passwords from Account settings.
# Run `node scripts/setup.mjs` to generate the initial password.
# Do not commit .env.local.
BOOKS_PASSWORD=

# Initial administrator username. Invitations create reader accounts only.
ADMIN_USERNAME=admin

# Public HTTPS address when using a domain. Leave empty for local use only.
PUBLIC_ORIGIN=

# Persistent storage, outside public/. Relative paths resolve from project root.
DATA_DIR=./data

# Maximum size of one uploaded PDF, in MiB. Large files use smaller requests.
MAX_UPLOAD_MB=256
